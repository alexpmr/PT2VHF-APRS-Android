    },
    "Boletim repetido em 24 horas não avisa de novo. O som e o estilo dos avisos são escolhidos nos Ajustes do iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bulletin repeated within 24 hours does not notify again. Notification sound and style are chosen in iPhone Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un boletín repetido en 24 horas no vuelve a avisar. El sonido y el estilo de los avisos se eligen en Ajustes del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bulletin répété dans les 24 heures ne notifie pas à nouveau. Le son et le style des alertes se choisissent dans Réglages de l'iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bollettino ripetuto entro 24 ore non avvisa di nuovo. Suono e stile degli avvisi si scelgono nelle Impostazioni di iPhone."
          }
        }
      }
    },
