    "Para bloquear, deslize a conversa ou mantenha pressionada a mensagem. Pacotes, estações e mensagens do indicativo bloqueado deixam de aparecer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To block, swipe the conversation or long-press the message. Packets, stations and messages from a blocked callsign stop appearing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bloquear, deslice la conversación o mantenga pulsado el mensaje. Los paquetes, estaciones y mensajes del indicativo bloqueado dejan de aparecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour bloquer, balayez la conversation ou touchez longuement le message. Les paquets, stations et messages de l'indicatif bloqué n'apparaissent plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per bloccare, scorri la conversazione o tieni premuto il messaggio. Pacchetti, stazioni e messaggi del nominativo bloccato non compaiono più."
          }
        }
      }
    },
