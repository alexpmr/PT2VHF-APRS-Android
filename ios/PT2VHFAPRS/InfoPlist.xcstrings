{
  "sourceLanguage": "pt-BR",
  "version": "1.0",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A posição é usada para mostrar estações próximas e enviar o seu beacon APRS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your position is used to show nearby stations and to send your APRS beacon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La posición se usa para mostrar estaciones cercanas y enviar su baliza APRS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position sert à afficher les stations proches et à envoyer votre balise APRS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione serve a mostrare le stazioni vicine e a inviare il tuo beacon APRS."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o rastreador ligado, a posição continua sendo enviada em segundo plano."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the tracker on, your position keeps being sent in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el rastreador activado, la posición se sigue enviando en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le traceur activé, la position continue d'être envoyée en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il tracker attivo, la posizione continua a essere inviata in background."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bluetooth conecta o app ao TNC KISS (BLE) do seu rádio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth connects the app to your radio's KISS TNC (BLE)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bluetooth conecta la app al TNC KISS (BLE) de su radio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bluetooth relie l'app au TNC KISS (BLE) de votre radio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Bluetooth collega l'app al TNC KISS (BLE) della tua radio."
          }
        }
      }
    }
  }
}